# PostgreSQL connection string — replace with your actual database URL.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/taskmate

# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173

# Set to "production" on your host.
NODE_ENV=development

# The host sets this automatically; do not set it yourself in production.
# PORT=3000
