# This file shows which environment variables the project needs.
# Copy it to .env in the relevant folder and fill in real values.
# Never commit .env files.

# --- server/.env ---
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/taskmate
CORS_ORIGINS=http://localhost:5173
NODE_ENV=development

# --- client/.env ---
VITE_API_BASE_URL=http://localhost:3000
